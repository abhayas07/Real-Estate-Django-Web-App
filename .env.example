# ==============================================================================
# Django Production Environment Variables
# Copy this file to .env for local testing, or set these in your hosting dashboard
# (e.g., Render, Railway, Heroku Environment Variables section)
# ==============================================================================

# Core Django Settings
DEBUG=False
SECRET_KEY=generate-a-strong-random-secret-key-for-production-use-min-50-chars

# Allowed Hosts: Comma-separated list of domains that can serve this site
# Example: ALLOWED_HOSTS=your-app.onrender.com,www.yourdomain.com,yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com

# CSRF Trusted Origins: Comma-separated list of full URLs (including https://)
# Required for form submissions (login, contact forms, admin) over HTTPS
# Example: CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Database Connection URL (PostgreSQL)
# Automatically provided by Render / Heroku / Railway PostgreSQL add-ons
# Example: DATABASE_URL=postgres://username:password@host:5432/dbname
DATABASE_URL=postgres://user:password@localhost:5432/realestate_db

# Security Settings (Optional overrides, defaults shown below)
# Set SECURE_SSL_REDIRECT=False only if testing production mode locally over HTTP
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
